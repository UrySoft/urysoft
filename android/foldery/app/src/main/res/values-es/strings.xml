    <string name="ui_android_will_ask_for_notification_access_f_313" formatted="false">"Android te pedirá acceso a las notificaciones. Foldery.2.AI solo utiliza la aplicación de origen y el estado del aviso para contar los avisos activos de tus widgets. No lee el texto, no guarda mensajes y no envía datos.\n\nPuedes revocar el acceso en cualquier momento. Los contadores no equivalen necesariamente a mensajes sin leer."</string>
    <string name="ui_not_now_314" formatted="false">"Ahora no"</string>
